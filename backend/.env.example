# Copy to .env locally. Never commit real API keys.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
PEXELS_API_KEY=
OUTPUT_DIR=output
FRONTEND_ORIGIN=http://localhost:3000
GENERATE_RATE_LIMIT=3
GENERATE_RATE_WINDOW_SECONDS=900
MAX_PEXELS_VIDEO_BYTES=104857600
OUTPUT_RETENTION_SECONDS=604800
MAX_CONCURRENT_GENERATIONS=1
